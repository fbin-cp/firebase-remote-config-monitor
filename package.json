{
    "name": "@fbin-cp/firebase-rc-monitor",
    "version": "1.0.0",
    "description": "Monitors changes to firebase remote config project(s) and posts changes to slack.",
    "author": "Jake Hall @ eBay",
    "license": "Apache-2.0",
    "repository": "https://github.com/fbin-cp/firebase-remote-config-monitor",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "npm run test-unit",
        "test-unit": "NODE_ENV=test mocha 'functions/src/test/*.spec.js'",
        "lint": "eslint .",
        "serve": "firebase serve --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-plugin-promise": "^7.3.0",
        "mocha": "^11.7.5",
        "sinon": "^22.0.0"
    },
    "dependencies": {
        "firebase-functions": "^7.0.0"
    }
}
